      "source": [
        "# Aprobación de crédito\n",
        "\n",
        "ingresos = 3000000\n",
        "deudas   = 600000\n",
        "\n",
        "capacidad = ingresos - deudas\n",
        "umbral    = 0.30 * ingresos\n",
        "\n",
        "if capacidad > umbral:\n",
        "    print(\"APROBADO\")\n",
        "else:\n",
        "    print(\"NEGADO\")"
      ],
